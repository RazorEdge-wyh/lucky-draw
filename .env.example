# lucky-draw 环境变量示例
#
# 复制为 .env 后按需修改（docker compose 会自动读取 .env 文件）。
# 所有变量都有内置默认值，因此这个文件可以完全为空。

# HTTP 监听端口
PORT=8080

# 一轮抽多少次
DRAW_COUNT=9

# 特殊号码（奖品对应的号码），必须落在 [MIN_NUMBER, MAX_NUMBER] 内
SPECIAL_NUMBER=4

# 特殊号码的单次命中权重（0..1）。其余号码均分 1-SPECIAL_PROB。
SPECIAL_PROB=0.15

# 号码池上下界
MIN_NUMBER=1
MAX_NUMBER=8

# 内部整轮重抽上限，超限后启用兜底构造
MAX_ATTEMPTS=5000
