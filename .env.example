# lucky-draw 环境变量示例
#
# 复制为 .env 后按需修改（docker compose 会自动读取 .env 文件）。
# 所有变量都有内置默认值，因此这个文件可以完全为空。

# HTTP 监听端口
PORT=8080

# 一轮抽多少次
DRAW_COUNT=9

# 号码池上下界（默认 1..8）
#
# 注意：**本轮第一个号码固定为 MAX_NUMBER**（池是 1..8 时即固定为 8）。
# 这是刻意设计的规则，不是随机结果；接口会在响应的 firstFixed / firstFixedHint
# 字段里如实声明，界面上第一个号码也会带星号标注。
# 想让首位固定为别的号码，改 MAX_NUMBER 即可（例如 MAX_NUMBER=12 → 首位固定 12）。
MIN_NUMBER=1
MAX_NUMBER=8

# ---------------------------------------------------------------------------
# 模式开关
# ---------------------------------------------------------------------------
# SPECIAL_NUMBER=0（默认）= 不做加权、不做整轮筛选；首位按上面的规则固定，
# 其余位置等概率随机。
#
# 设为号码池内的某个号码则切回**有偏模式**（项目最初的算法）：
# 该号码按 SPECIAL_PROB 加权，并且整轮必须满足「它是唯一最高票」，否则整轮重抽。
# 也就是说：非 0 = 必定命中该号码。
#
# 例：SPECIAL_NUMBER=4 会让每轮九次一定命中 4，且 4 是唯一最高票。
# 老算法的完整说明见 docs/legacy-biased-algorithm.md。
SPECIAL_NUMBER=0

# 以下两项只在有偏模式（SPECIAL_NUMBER 非 0）下生效。

# 特殊号码的单次命中权重（0..1）。其余号码均分 1-SPECIAL_PROB。
SPECIAL_PROB=0.15

# 内部整轮重抽上限，超限后启用兜底构造（保证接口永不挂起）
MAX_ATTEMPTS=5000
